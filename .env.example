# Copy to .env and fill in values from accounts provisioned by the project owner.
# Never commit .env or share credentials in source control.

# Managed PostgreSQL connection string. Require TLS for remote databases.
DATABASE_URL=

# Qdrant endpoint and optional API key. Remote endpoints must use HTTPS.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=cis_fin_chunks_nomic_v1
QDRANT_EMBEDDING_VERSION=nomic-embed-text-v1

# S3-compatible object storage. Use a least-privilege service account.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Default local PDF extractor and bounded ingestion concurrency.
CIS_FIN_EXTRACTOR=pymupdf
CIS_FIN_MAX_CONCURRENT_INGESTIONS=2

# Optional local .xlsx metadata workbook (default: data/company_metadata.xlsx).
CIS_FIN_METADATA_WORKBOOK=

# Local question generation and embeddings.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Optional web classification lookup.
TAVILY_API_KEY=

# Configure local app users through the approved secrets manager.
CIS_FIN_USER_1_USERNAME=
CIS_FIN_USER_1_PASSWORD=
CIS_FIN_USER_2_USERNAME=
CIS_FIN_USER_2_PASSWORD=
CIS_FIN_USER_3_USERNAME=
CIS_FIN_USER_3_PASSWORD=
CIS_FIN_USER_4_USERNAME=
CIS_FIN_USER_4_PASSWORD=
CIS_FIN_USER_5_USERNAME=
CIS_FIN_USER_5_PASSWORD=
