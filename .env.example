# Copy to .env and fill in values from accounts provisioned by the project owner.
# Never commit .env or share credentials in source control.

# Managed PostgreSQL connection string. Require TLS for remote databases.
DATABASE_URL=

# Qdrant endpoint and API key. Remote endpoints must use HTTPS.
QDRANT_URL=
QDRANT_API_KEY=

# S3-compatible object storage. Use a least-privilege service account.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Default local PDF extractor (PyMuPDF works in the pinned environment).
CIS_FIN_EXTRACTOR=pymupdf

# Maximum simultaneous ingestion jobs per shared database (bounded: 1-16).
CIS_FIN_MAX_CONCURRENT_INGESTIONS=2

# Local question generation and embeddings. Pull both configured models in Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Qdrant vector collection; the collection is created automatically on first ingestion.
QDRANT_COLLECTION=cis_fin_chunks_nomic_v1
QDRANT_EMBEDDING_VERSION=nomic-embed-text-v1
